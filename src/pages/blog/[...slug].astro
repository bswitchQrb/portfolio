---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config';
import { formatDate, getPublishedPosts, type BlogPost } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title={`${post.data.title} | ${SITE.name}`}
  description={post.data.description}
  path={`blog/${post.id}/`}
  ogType="article"
>
  <Header />
  <main class="section article-main">
    <article class="container article">
      <header class="article-header">
        <p class="article-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.updatedDate && (
            <span>
              （更新：<time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>）
            </span>
          )}
          {post.data.draft && <span class="draft-badge">DRAFT</span>}
        </p>
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <div class="chip-row">
            {post.data.tags.map((tag) => (
              <span class="chip chip--sky">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      <p class="back">
        <a href={`${base}/blog/`} class="pixel-btn">記事一覧へ</a>
      </p>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .article-main {
    padding-top: 8rem;
  }

  .article {
    max-width: 780px;
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 3px solid var(--line-dim);
  }

  .article-meta {
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    color: var(--text-dim);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .draft-badge {
    color: var(--coral);
    border: 2px solid currentColor;
    padding: 0 0.4rem;
    font-size: 0.75rem;
  }

  .article-title {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.5;
    color: var(--gold);
    margin: 0.5rem 0 1rem;
  }

  .back {
    margin-top: 4rem;
  }

  @media (max-width: 760px) {
    .article-main {
      padding-top: 7rem;
    }

    .article-title {
      font-size: 1.4rem;
    }
  }
</style>
