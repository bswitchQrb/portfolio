---
---

<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title">Projects</h2>

    <div class="project-card">
      <div class="project-header">
        <div class="project-label">
          <span class="label-dot"></span>
          Personal Project
        </div>
        <a
          href="https://onpu.onrender.com/onpu/"
          target="_blank"
          rel="noopener"
          class="project-link"
        >
          Live Demo &#8599;
        </a>
      </div>

      <h3 class="project-name">Onpu Quiz</h3>
      <p class="project-tagline">
        五線譜の音符をピアノ鍵盤で回答する、音楽学習クイズアプリ
      </p>

      <div class="project-features">
        <div class="feature">
          <span class="feature-icon">&#9835;</span>
          <div>
            <h4 class="feature-title">5つのクイズモード</h4>
            <p class="feature-desc">ト音記号・ヘ音記号の単音/和音、コード名当てに対応</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature-icon">&#9881;</span>
          <div>
            <h4 class="feature-title">弱点克服アルゴリズム</h4>
            <p class="feature-desc">正答率に応じた重み付き出題で、苦手な音を重点的に学習</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature-icon">&#9878;</span>
          <div>
            <h4 class="feature-title">フルスタック構成</h4>
            <p class="feature-desc">React + Spring Boot + PostgreSQL のクリーンアーキテクチャ</p>
          </div>
        </div>
      </div>

      <div class="project-tech">
        <h4 class="tech-heading">Tech Stack</h4>
        <div class="tech-row">
          <div class="tech-group">
            <span class="tech-label">Frontend</span>
            <div class="tech-items">
              <span class="tech-chip tech-chip--cyan">React 19</span>
              <span class="tech-chip tech-chip--cyan">TypeScript</span>
              <span class="tech-chip tech-chip--cyan">Vite</span>
              <span class="tech-chip tech-chip--cyan">VexFlow</span>
            </div>
          </div>
          <div class="tech-group">
            <span class="tech-label">Backend</span>
            <div class="tech-items">
              <span class="tech-chip tech-chip--pink">Spring Boot 3</span>
              <span class="tech-chip tech-chip--pink">Java 17</span>
              <span class="tech-chip tech-chip--pink">jOOQ</span>
              <span class="tech-chip tech-chip--pink">JWT</span>
            </div>
          </div>
          <div class="tech-group">
            <span class="tech-label">Infra</span>
            <div class="tech-items">
              <span class="tech-chip tech-chip--purple">PostgreSQL</span>
              <span class="tech-chip tech-chip--purple">Docker</span>
              <span class="tech-chip tech-chip--purple">Render</span>
              <span class="tech-chip tech-chip--purple">Supabase</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .project-card {
    background: var(--bg-card);
    border: 1px solid rgba(0, 245, 255, 0.12);
    border-radius: 12px;
    padding: 2.5rem;
    transition: all 0.4s ease;
  }

  .project-card:hover {
    border-color: rgba(0, 245, 255, 0.3);
    box-shadow: 0 0 40px rgba(0, 245, 255, 0.06);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .project-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--neon-green);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .label-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--neon-green);
    box-shadow: 0 0 6px var(--neon-green);
    animation: glow-pulse 2s ease-in-out infinite;
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--neon-cyan);
    padding: 0.4rem 1rem;
    border: 1px solid rgba(0, 245, 255, 0.3);
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .project-link:hover {
    background: rgba(0, 245, 255, 0.1);
    box-shadow: var(--neon-cyan-glow);
  }

  .project-name {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .project-tagline {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  /* Features */
  .project-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .feature {
    display: flex;
    gap: 0.75rem;
  }

  .feature-icon {
    font-size: 1.5rem;
    color: var(--neon-purple);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .feature-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
  }

  .feature-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Tech Stack */
  .tech-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .tech-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tech-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .tech-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    border: 1px solid;
  }

  .tech-chip--cyan {
    color: var(--neon-cyan);
    border-color: rgba(0, 245, 255, 0.25);
    background: rgba(0, 245, 255, 0.05);
  }

  .tech-chip--pink {
    color: var(--neon-pink);
    border-color: rgba(255, 45, 149, 0.25);
    background: rgba(255, 45, 149, 0.05);
  }

  .tech-chip--purple {
    color: var(--neon-purple);
    border-color: rgba(180, 77, 255, 0.25);
    background: rgba(180, 77, 255, 0.05);
  }

  @media (max-width: 768px) {
    .project-features {
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 1.5rem;
    }

    .tech-row {
      flex-direction: column;
    }
  }
</style>
