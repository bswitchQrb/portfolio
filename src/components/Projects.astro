---
import { SIDE_PROJECTS } from '../config';

const features = [
  {
    icon: '♫',
    title: '5つのクイズモード',
    desc: 'ト音記号・ヘ音記号の単音/和音、コード名当てに対応',
  },
  {
    icon: '⚙',
    title: '苦手な音を多めに出題',
    desc: '正答率が低い音ほど出やすくして、苦手を重点的に練習できる',
  },
  {
    icon: '⚖',
    title: 'フルスタック構成',
    desc: 'フロントは React、API は Spring Boot、DB は PostgreSQL',
  },
];

const techGroups = [
  { label: 'Frontend', color: 'sky', items: ['React 19', 'TypeScript', 'Vite', 'VexFlow'] },
  { label: 'Backend', color: 'coral', items: ['Spring Boot 3', 'Java 17', 'jOOQ', 'JWT'] },
  { label: 'Infra', color: 'lilac', items: ['PostgreSQL', 'Docker', 'Render', 'Supabase'] },
];
---

<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title">SIDE QUEST<span class="section-sub">Projects</span></h2>

    <article class="window project">
      <span class="window-label">PERSONAL PROJECT</span>

      <div class="project-header">
        <div>
          <h3 class="project-name">Onpu Quiz</h3>
          <p class="project-tagline">五線譜の音符をピアノ鍵盤で回答する、音楽学習クイズアプリ</p>
        </div>
        <a
          href="/onpu/"
          target="_blank"
          rel="noopener"
          class="pixel-btn"
        >
          Live Demo ↗
        </a>
      </div>

      <ul class="project-features">
        {features.map((f) => (
          <li class="feature">
            <span class="feature-icon" aria-hidden="true">{f.icon}</span>
            <div>
              <p class="feature-title">{f.title}</p>
              <p class="feature-desc">{f.desc}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="project-tech">
        <h4 class="block-heading">EQUIPMENT</h4>
        <div class="tech-row">
          {techGroups.map((g) => (
            <div class="tech-group">
              <span class="tech-label">{g.label}</span>
              <div class="chip-row">
                {g.items.map((item) => (
                  <span class={`chip chip--${g.color}`}>{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </article>

    <div class="side-projects">
      {SIDE_PROJECTS.map((project) => (
        <article class="window side-project">
          <span class="window-label">PERSONAL PROJECT</span>
          <h3 class="side-name">{project.name}</h3>
          <p class="project-tagline">{project.tagline}</p>
          {project.screenshot && (
            <img
              src={project.screenshot.src}
              alt={project.screenshot.alt}
              class="side-shot"
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="chip-row">
            {project.tech.map((item) => (
              <span class="chip chip--green">{item}</span>
            ))}
          </div>
          <div class="side-links">
            {project.links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener" class="pixel-btn">
                {link.label} ↗
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .project {
    padding-top: 2.5rem;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .project-name {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 2rem;
    color: var(--text);
    text-shadow: 3px 3px 0 var(--shadow);
    margin-bottom: 0.4rem;
  }

  .project-tagline {
    color: var(--text-dim);
  }

  .project-features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 2px dotted var(--line-dim);
    border-bottom: 2px dotted var(--line-dim);
    margin-bottom: 1.5rem;
  }

  .feature {
    display: flex;
    gap: 0.75rem;
  }

  .feature-icon {
    font-size: 1.3rem;
    line-height: 1.4;
    color: var(--gold);
    flex-shrink: 0;
  }

  .feature-title {
    font-family: var(--font-pixel);
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .feature-desc {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.8;
  }

  .block-heading {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--gold);
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
  }

  .tech-group {
    display: grid;
    gap: 0.5rem;
  }

  .tech-label {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--text-dim);
    letter-spacing: 0.1em;
  }

  .side-projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
    margin-top: 3.5rem;
  }

  .side-project {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2.25rem;
  }

  .side-name {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 1.4rem;
    color: var(--text);
    text-shadow: 3px 3px 0 var(--shadow);
  }

  .side-shot {
    width: 100%;
    height: auto;
    border: 3px solid var(--line-dim);
    background: var(--bg-deep);
  }

  .side-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (max-width: 760px) {
    .side-projects {
      grid-template-columns: 1fr;
    }

    .window.side-project {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .window.project {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .project-name {
      font-size: 1.6rem;
    }

    .project-features {
      grid-template-columns: 1fr;
    }
  }
</style>
