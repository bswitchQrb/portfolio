---
import { EXPERIENCE, CERTIFICATIONS } from '../config';
---

<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title">QUEST LOG<span class="section-sub">Experience</span></h2>

    <div class="quests">
      {EXPERIENCE.map((exp) => (
        <article class="window quest">
          <span class="window-label">{exp.period}</span>

          <h3 class="quest-company">{exp.company}</h3>
          <p class="quest-roles">
            {exp.roles.map((role, idx) => (
              <>
                {idx > 0 && <span class="role-arrow" aria-label="から">▶</span>}
                <span class="chip chip--coral">{role}</span>
              </>
            ))}
          </p>
          <p class="quest-summary">{exp.summary}</p>

          <div class="quest-block">
            <h4 class="block-heading">PHASES</h4>
            <div class="chip-row">
              {exp.phases.map((phase) => (
                <span class="chip chip--sky">{phase}</span>
              ))}
            </div>
          </div>

          <div class="quest-block">
            <h4 class="block-heading">HIGHLIGHTS</h4>
            <ul class="highlight-grid">
              {exp.highlights.map((h) => (
                <li class="highlight">
                  <span class="highlight-icon" aria-hidden="true">★</span>
                  <div>
                    <p class="highlight-title">{h.title}</p>
                    <p class="highlight-desc">{h.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="quest-block">
            <h4 class="block-heading">EQUIPMENT</h4>
            <div class="chip-row">
              {exp.stack.map((tech) => (
                <span class="chip chip--lilac">{tech}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="window cert">
      <span class="window-label">ACHIEVEMENTS</span>
      <ul class="cert-list">
        {CERTIFICATIONS.map((c) => (
          <li class="cert-item">
            <span class="cert-icon" aria-hidden="true">◆</span>
            <span class="cert-name">{c.name}</span>
            <span class="cert-date">{c.date}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .quests {
    display: grid;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .quest {
    padding-top: 2.5rem;
  }

  .quest-company {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .quest-roles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .role-arrow {
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  .quest-summary {
    line-height: 2;
  }

  .quest-block {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 2px dotted var(--line-dim);
  }

  .block-heading {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--gold);
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
  }

  .highlight-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 2rem;
  }

  .highlight {
    display: flex;
    gap: 0.6rem;
  }

  .highlight-icon {
    color: var(--gold);
    flex-shrink: 0;
    line-height: 1.6;
  }

  .highlight-title {
    font-family: var(--font-pixel);
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .highlight-desc {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.8;
  }

  .cert {
    padding-top: 2.25rem;
  }

  .cert-list {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .cert-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-pixel);
  }

  .cert-icon {
    color: var(--green);
  }

  .cert-name {
    color: var(--text);
  }

  .cert-date {
    margin-left: auto;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .window.quest,
    .window.cert {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .quest-company {
      font-size: 1.25rem;
    }

    .highlight-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
