---
const skillCategories = [
  {
    title: 'FRONTEND',
    color: 'sky',
    skills: ['TypeScript', 'React'],
  },
  {
    title: 'BACKEND',
    color: 'coral',
    skills: ['Java / Spring Boot', 'MySQL', 'PostgreSQL'],
  },
  {
    title: 'DEVOPS & TOOLS',
    color: 'lilac',
    skills: ['AWS', 'Docker', 'Terraform', 'Git', 'Claude Code'],
  },
];
---

<section id="skills" class="section">
  <div class="container">
    <h2 class="section-title">SKILLS</h2>

    <div class="skills-grid">
      {skillCategories.map((category) => (
        <div class={`window skill-window skill-window--${category.color}`}>
          <span class="window-label">{category.title}</span>
          <ul class="skill-list">
            {category.skills.map((skill) => (
              <li class="skill-item">{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 1.75rem;
  }

  .skill-window {
    padding: 2.25rem 1.5rem 1.5rem;
  }

  .skill-list {
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .skill-item {
    font-family: var(--font-pixel);
    font-size: 1.05rem;
    color: var(--text);
    display: flex;
    align-items: center;
    padding: 0.2rem 0;
  }

  .skill-item::before {
    content: '▶';
    font-size: 0.7em;
    width: 1.4em;
    flex-shrink: 0;
    visibility: hidden;
  }

  .skill-item:hover::before {
    visibility: visible;
  }

  .skill-window--sky .skill-item::before { color: var(--sky); }
  .skill-window--coral .skill-item::before { color: var(--coral); }
  .skill-window--lilac .skill-item::before { color: var(--lilac); }

  .skill-window--sky .window-label { color: var(--sky); }
  .skill-window--coral .window-label { color: var(--coral); }
  .skill-window--lilac .window-label { color: var(--lilac); }

  @media (max-width: 860px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
