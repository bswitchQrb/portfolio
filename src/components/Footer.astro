---
import { SITE } from '../config';
---

<footer id="contact" class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-cta">
        <h2 class="footer-title">Links</h2>
      </div>

      <div class="footer-links">
        <a href={SITE.github} target="_blank" rel="noopener" class="social-link">
          <span class="social-icon">GH</span>
          <span class="social-name">GitHub</span>
        </a>
        <a href={SITE.zenn} target="_blank" rel="noopener" class="social-link">
          <span class="social-icon">Z</span>
          <span class="social-name">Zenn</span>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-line"></div>
      <p class="copyright">
        <span class="copy-symbol">&copy;</span> 2026 {SITE.name}. Built with
        <span class="tech-love">Astro</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 6rem 0 2rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .footer-title {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }





  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background: var(--bg-card);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .social-link:hover {
    border-color: var(--neon-purple);
    box-shadow: 0 0 20px rgba(180, 77, 255, 0.15);
    transform: translateY(-3px);
  }

  .social-icon {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .social-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-bottom {
    text-align: center;
  }

  .footer-line {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 245, 255, 0.2),
      rgba(255, 45, 149, 0.2),
      transparent
    );
    margin-bottom: 1.5rem;
  }

  .copyright {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .tech-love {
    color: var(--neon-pink);
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
