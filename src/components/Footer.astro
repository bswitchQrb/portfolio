---
import { SITE } from '../config';

const links = [
  { href: SITE.github, label: 'GitHub' },
  { href: SITE.zenn, label: 'Zenn' },
];
---

<footer id="contact" class="footer">
  <div class="container">
    <h2 class="section-title">LINKS</h2>

    <div class="footer-links">
      {links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener" class="pixel-btn">
          {link.label} ↗
        </a>
      ))}
    </div>

    <div class="footer-bottom">
      <p class="thanks">THANK YOU FOR PLAYING</p>
      <p class="copyright">&copy; 2026 {SITE.name} — Built with Astro</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 5rem 0 2.5rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 5rem;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 3px solid var(--line-dim);
  }

  .thanks {
    font-family: var(--font-pixel);
    font-size: 1rem;
    color: var(--gold);
    letter-spacing: 0.2em;
    margin-bottom: 0.5rem;
  }

  .copyright {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--text-dim);
  }
</style>
