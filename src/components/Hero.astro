---
import { SITE } from '../config';

// Pixel-art monitor. o = frame, s = screen, g = text, y = cursor, b = stand
const inner = [
  '              ',
  ' ggg gggg     ',
  '              ',
  ' gggg ggggggg ',
  '              ',
  ' gg y         ',
  '              ',
];
const sprite = [
  'oooooooooooooooo',
  ...inner.map((row) => `o${row.replaceAll(' ', 's')}o`),
  'oooooooooooooooo',
  '......bbbb......',
  '....bbbbbbbb....',
];
const fills: Record<string, string> = {
  o: 'var(--line)',
  s: 'var(--bg-deep)',
  g: 'var(--green)',
  y: 'var(--gold)',
  b: 'var(--line-dim)',
};
const pixels = sprite.flatMap((row, y) =>
  [...row].flatMap((c, x) => (c === '.' ? [] : [{ x, y, c }]))
);
---

<section class="hero" id="top">
  <div class="container hero-content">
    <div class="hero-main">
      <p class="hero-badge">— PORTFOLIO —</p>
      <h1 class="hero-title">{SITE.name}</h1>
      <p class="hero-role">
        <span class="role-key">CLASS</span>
        {SITE.role}
      </p>

      <div class="window message">
        <p>
          自社のプロジェクト管理SaaSを開発しています。<br />
          フロントもバックエンドも、AWS まわりも触ります。
        </p>
        <span class="message-next blink" aria-hidden="true">▼</span>
      </div>

      <div class="hero-actions">
        <a href="#about" class="pixel-btn">START</a>
        <a href={SITE.github} target="_blank" rel="noopener" class="pixel-btn">GitHub ↗</a>
      </div>
    </div>

    <svg
      class="hero-sprite"
      viewBox={`0 0 16 ${sprite.length}`}
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      {pixels.map((p) => (
        <rect
          x={p.x}
          y={p.y}
          width="1"
          height="1"
          fill={fills[p.c]}
          class={p.c === 'y' ? 'blink' : undefined}
        />
      ))}
    </svg>
  </div>
</section>

<style>
  .hero {
    min-height: min(100vh, 860px);
    display: flex;
    align-items: center;
    padding: 7rem 0 4rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 3rem;
    width: 100%;
  }

  .hero-badge {
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    color: var(--text-dim);
    letter-spacing: 0.3em;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 4.5rem);
    line-height: 1.15;
    color: var(--text);
    letter-spacing: 0.04em;
    text-shadow: 4px 4px 0 var(--shadow);
    margin-bottom: 1rem;
    overflow-wrap: anywhere;
  }

  .hero-role {
    font-family: var(--font-pixel);
    font-size: 1.1rem;
    color: var(--green);
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .role-key {
    font-size: 0.8rem;
    color: var(--bg-deep);
    background: var(--green);
    padding: 0 0.4rem;
  }

  .message {
    max-width: 560px;
    padding: 1.5rem 2rem 1.75rem;
    font-size: 1rem;
    line-height: 2;
  }

  .message-next {
    position: absolute;
    right: 1rem;
    bottom: 0.4rem;
    font-size: 0.75rem;
    color: var(--gold);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .hero-sprite {
    width: 192px;
    height: auto;
    filter: drop-shadow(6px 6px 0 var(--shadow));
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      padding-top: 8rem;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-sprite {
      grid-row: 1;
      width: 112px;
    }

    .message {
      padding: 1.25rem 1.25rem 1.5rem;
    }
  }
</style>
